# PostgreSQL connection string from Supabase.
# Server-only. Never expose this in the browser.
DATABASE_URL=

# Supabase public project config used by Auth.
# These values are safe to expose because they are public client settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback name supported by the app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Powerful server-only Supabase key.
# Not needed for the current MVP. Leave empty unless a future admin workflow
# explicitly requires it.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to protect POST /api/jobs/aggregate.
CRON_SECRET=

# Requests accepted per API key per minute.
INGESTION_RATE_LIMIT_PER_MINUTE=120

# Optional local demo key for the /app/integration tester.
# Do not use a production customer key here.
NEXT_PUBLIC_INGESTION_TEST_KEY=

# Optional seed key. When empty, the seed creates a random API key.
SEED_DEMO_API_KEY=
